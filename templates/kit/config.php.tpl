/**
 * {{APP_NAME}} SSO — конфиг интеграции для {{CLIENT_NAME}}.
 * Файл живёт ТОЛЬКО на сервере, вне git. Сгенерировано {{GENERATED_AT}}.
 */
/*
 * СЕКРЕТЫ СЮДА ВПИСЫВАТЬ НЕ НУЖНО. Этот файл лежит в веб-корне и, скорее
 * всего, в git — то есть ровно там, где секрету не место. Установщик
 * (sso/install.php) кладёт client_secret и users_secret отдельным файлом
 * уровнем выше, а bootstrap.php подставляет их поверх этих значений.
 * Плейсхолдеры ниже — нормальное состояние, а не недоделка.
 *
 * Если установщик недоступен, значения можно вписать и здесь: это работает,
 * но годится для быстрой пробы, а не для боя.
 */
return [
    'issuer'        => '{{ISSUER}}',
    'client_id'     => '{{CLIENT_ID}}',
    'client_secret' => '{{CLIENT_SECRET}}',   // приходит из хранилища вне веб-корня
    'redirect_uri'  => '{{REDIRECT_URI}}',
    // Другие адреса этого же сайта (алиасы), например ['www.example.com'].
    // Открыли сайт по алиасу — возврат после входа на тот же алиас: сессия
    // входа живёт в cookie алиаса, и возврат на основной адрес её бы не нашёл.
    // Адрес возврата на алиасе добавьте в карточку портала в {{APP_NAME}}.
    'aliases'       => [],
    'post_logout'   => '{{POST_LOGOUT_URI}}',
    'scopes'        => '{{SCOPES}}',
    // Ключ переноса людей (sso/users.php). Выдаётся отдельной кнопкой в карточке
    // портала: «Забрать людей» → «Выдать ключ переноса». Пусто — выгрузка
    // отвечает 500 и никого не отдаёт, вход при этом работает как обычно.
    'users_secret'  => '{{USERS_SECRET}}',
    // Аварийный вход по своему паролю, мимо {{APP_NAME}}. Держите false.
    //
    // Вторая дверь не дублирует вход, а отменяет его защиту: политика паролей,
    // блокировки, 2FA и замок живут в {{APP_NAME}}, и тому, кто ломится, хватит
    // двери, где ничего этого нет. Включать — правкой этого файла на сервере
    // (не галочкой в админке: угнанная админка не должна открывать себе запасной
    // ход), на время недоступности SSO, каждый такой вход — в журнал.
    // Первого администратора так заводить не нужно: в карточке портала есть
    // кнопка «Setup-ссылка для админа портала».
    'allow_local_login' => false,
    // Служебные каталоги (создаются автоматически, нужен доступ на запись)
    'var_dir'       => __DIR__ . '/var',
];
